  "disputed_attribution": {
    "anchor": {
      "note": "fresh-e2f6a33d7a",
      "field": "markov.signed_signal",
      "claim": "fresh-e2f6a33d7a#1"
    },
    "reading": "All nine wrong or wrong-field seeded outcomes, and the one natural wrong_field, come from this one anchor. Each seeded change moved or removed the field the labeller named, markov.signed_signal, and the checker compared the one it named, markov.conviction. The evidence-side changes also left conviction and the probabilities at their old values, so those cases hold competing evidence for one quantity. The nine follow the registered scoring rules, but they are one disputed interpretation, not nine independent checker mistakes, and they do not settle which field the note names."
  },
  "incoherent_synthetic_evidence": {
    "reading": "The Markov model computes signed_signal as bull_prob less bear_prob and conviction as its magnitude; the probabilities sum to one and direction is the sign. All four hold in the evidence of every one of the 51 notes. The seeded changes moved one field at a time, so evidence_value_up, evidence_value_down and both_moved on a Markov field left evidence the model cannot produce, and a ratio of 1.37 carried some convictions, one signal and two break risks past their bounds. Those cases remain valid single-field arithmetic tests: the key is the truth of the written figure against the stored field. They are not coherent market contexts, so both_moved's 66 of 71 is acceptance of single-field arithmetic, not of 71 unambiguously correct notes. The support's distance and Quiver's direction are not checked, because neither relation holds in every original note.",
    "checks": "jev_fresh::context_problems"
  },
  "removed_yet_derivable": {
    "reading": "evidence_removed deletes one field and keys the figure unsettleable. Where the model's links still determine the removed value -- the signal as bull less bear, conviction as the signal's magnitude -- a reader could settle it from the remaining evidence. The checker leaving it uncompared is still correct under the protocol, which asks whether the field is present; the key's word 'unsettleable' overstates it for these cases.",
    "checks": "jev_fresh::derivable_after_removal"
  },

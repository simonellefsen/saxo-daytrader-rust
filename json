  namespace: saxo
spec:
  replicas: 1
  selector:
    matchLabels:
      app: hermes-agent
  strategy:
    type: Recreate
  template:
    metadata:
      labels:
        app: hermes-agent
    spec:
      automountServiceAccountToken: false
      containers:
      - command:
        - /bin/sh
        - -lc
        - |
          if [ -n "${HERMES_MODEL:-}" ]; then
            /opt/hermes/.venv/bin/python /opt/hermes/hermes config set model.default "$HERMES_MODEL" || true
          fi
          if [ -n "${HERMES_INFERENCE_PROVIDER:-}" ]; then
            /opt/hermes/.venv/bin/python /opt/hermes/hermes config set model.provider "$HERMES_INFERENCE_PROVIDER" || true
          fi
          if [ -n "${HERMES_DAYTRADER_API_KEY:-}" ]; then
            /opt/hermes/.venv/bin/python - <<'PY' || true
          import os
          from pathlib import Path

          import yaml

          path = Path("/opt/data/config.yaml")
          data = {}
          if path.exists():
              data = yaml.safe_load(path.read_text()) or {}
          servers = data.setdefault("mcp_servers", {})
          servers["daytrader"] = {
              "url": os.environ.get("DAYTRADER_MCP_URL", "http://daytrader-mcp.saxo:8610/mcp"),
              "headers": {
                  "Authorization": f"Bearer {os.environ['HERMES_DAYTRADER_API_KEY']}"
              },
              "timeout": 30,
              "connect_timeout": 5,
              "supports_parallel_tool_calls": False,
              "tools": {
                  "include": [
                      "get_app_capabilities",
                      "get_goal_contract",
                      "get_context",
                      "get_decision_reports",
                      "get_end_of_day_reports",
                      "get_markov_signals",
                      "get_quiver_signals",
                      "list_reflections",
                      "create_reflection",
                      "list_experiments",
                      "create_experiment_proposal",
                      "create_decision_advice",
                  ],
                  "resources": False,
                  "prompts": False,
              },
          }
          path.write_text(yaml.safe_dump(data, sort_keys=False))
          PY
          fi
          exec /opt/hermes/.venv/bin/python /opt/hermes/hermes gateway run
        envFrom:
        - secretRef:
            name: hermes-env
            optional: true
        image: docker.io/nousresearch/hermes-agent@sha256:b6e41c155d6bfce5ad83c5d0fec670086db8a43250e4511c9474134be5482d33
        imagePullPolicy: IfNotPresent
        name: hermes
        ports:

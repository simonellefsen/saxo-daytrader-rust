            memory: 512Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 10000
          runAsNonRoot: true
          runAsUser: 10000
          seccompProfile:
            type: RuntimeDefault
        volumeMounts:
        - mountPath: /opt/data
          name: data
        - mountPath: /tmp
          name: tmp
        - mountPath: /dev/shm
          name: dev-shm
        - mountPath: /opt/daytrader-context
          name: daytrader-context
          readOnly: true
      initContainers:
      - command:
        - /bin/sh
        - -ec
        - |
          for attempt in $(seq 1 60); do
            if curl -fsS http://daytrader-mcp.saxo:8610/health >/dev/null; then
              exit 0
            fi
            sleep 2
          done
          echo "daytrader-mcp did not become ready before Hermes startup" >&2
          exit 1
        image: curlimages/curl:8.17.0
        imagePullPolicy: IfNotPresent
        name: wait-for-daytrader-mcp
        resources:
          limits:
            cpu: 100m
            memory: 128Mi
          requests:
            cpu: 10m
            memory: 32Mi
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
          runAsGroup: 10000
          runAsNonRoot: true
          runAsUser: 10000
          seccompProfile:
            type: RuntimeDefault
      securityContext:
        fsGroup: 10000
        runAsGroup: 10000
        runAsNonRoot: true
        runAsUser: 10000
        seccompProfile:
          type: RuntimeDefault
      volumes:
      - name: data
        persistentVolumeClaim:
          claimName: hermes-data
      - emptyDir: {}
        name: tmp
      - emptyDir:
          medium: Memory
          sizeLimit: 1Gi
        name: dev-shm
      - configMap:
          name: hermes-daytrader-context

    scheduler:
      enabled: true
      poll_interval_minutes: 10
      startup_run: true
      history_max_rows: 250
      history_retention_days: 30

    strategy:
      # Read-only comparison of the account value series with Saxo-resolved ETF
      # proxies. These are price returns, not index total returns: no dividends,
      # FX-normalization, or cash-flow adjustment is claimed. They are deliberately
      # outside Decision Reports, Trading Manager, and broker execution. The daily
      # end-of-day journal can expose them to Hermes as read-only context only.
      performance_benchmarks:
        enabled: true
        timezone: Europe/Copenhagen
        # Runs after the regular US close and before the 22:30 EOD journal, so the
        # journal compares the completed day instead of yesterday's proxy close.
        daily_time: "22:15"
        run_weekdays_only: true
        sample_count: 1260
        references:
          - key: us_large_cap
            label: S&P 500 (SPY ETF proxy)
            symbol: SPY:arcx
          - key: us_technology
            label: Nasdaq-100 (QQQ ETF proxy)
            symbol: QQQ:xnas
          - key: us_blue_chip
            label: Dow Jones Industrial Average (DIA ETF proxy)
            symbol: DIA:arcx
          - key: global_equity
            label: MSCI World (EUNL ETF proxy)
            symbol: EUNL:xetr
          - key: europe_broad
            label: MSCI Europe (EUNK ETF proxy)
            symbol: EUNK:xetr
          - key: uk_large_cap
            label: FTSE 100 (ISF ETF proxy)
            symbol: ISF:xlon
      enabled: true
      mode: swing
      selection_interval_minutes: 15
      max_candidates: 20
      max_selected_assets: 8
      # Exchange/currency concentration gates are wired and audited, but start in
      # explicit unlimited mode until an operator chooses live limits. Nonzero
      # values cap distinct held/planned BUY symbols; negative values fail BUYs
      # closed rather than weakening diversification evidence.
      concentration:
        max_assets_per_exchange: 0
        max_assets_per_currency: 0
      # BUYs require a verified indicator target to clear the exchange-minimum
      # round-trip commission plus this one-way slippage estimate. This is a
      # lower-bound cost model, not a realised-fill forecast.
      estimated_slippage_bps: 8
      # Multiplies the round-trip minimum commission in the same BUY cost guard.
      # Zero disables only this commission multiplier; invalid negative values
      # fail closed during queueing.
      cost_guard_multiple: 1.5
      capital:
        max_deployment_pct: 0.98
        min_cash_buffer_pct: 0.02
        reinvestment_pressure_threshold_pct: 0.05
        # Reduce the cycle-wide BUY budget while the monthly P/L is between this
        # floor and the hard halt. It must be a less-severe negative number than
        # monthly_loss_halt_dkk; invalid/disabled bands do not reduce deployment.
        # Rescaled 2026-07-25 against the +15%/year goal on a ~300,000 DKK book.
        # The previous -25,000/-50,000 pair was -8.2%/-16.4% of the portfolio in a
        # single month, so one bad month could erase roughly a year of target gains
        # before the hard halt fired. Now -3% soft and -6% hard, same 2:1 ratio.
        monthly_loss_soft_reduce_dkk: -9000
        monthly_loss_soft_buy_multiplier: 0.50
        # Suspend new BUYs when month P/L (goal-tracking baseline) breaches this
        # hard floor; SELLs are never blocked. Set >= 0 to disable both loss tiers.
        monthly_loss_halt_dkk: -18000
        # Portfolio drawdown guardrail. Unlike the monthly floors above, this does
        # not reset on the 1st: it measures the current total portfolio value
        # against its highest value in the trailing window, so a decline that
        # straddles a month boundary stays visible. drawdown_halt_pct is the same
        # number the Hermes goal contract publishes as max_drawdown; the contract
        # reads this key, so the two cannot drift apart. Set <= 0 to disable both
        # tiers. Too little history disables the guardrail rather than tripping it.
        # Widened 0.20 -> 0.25 on 2026-08-04 by operator decision. The book sat at
        # 19.37% against the 20% floor (peak 297,463 DKK on 2026-06-30, current
        # ~240,300), so a ~1% day would have suspended BUYs with no re-entry rule
        # defined -- the guardrail can stop a decline but has no notion of how a
        # halted book resumes. The soft band stays at 0.10 deliberately: it is
        # already active and halving the cycle BUY budget, so caution is retained
        # rather than removed. Revisit the pair together, and note the halt only
        # falls back below the peak's influence once 2026-06-30 leaves the
        # 90-day lookback (around 2026-09-28).
        drawdown_lookback_days: 90
        drawdown_soft_reduce_pct: 0.10
        # 0.75 from 2026-08-31. At 0.50 the halved budget funded exactly one
        # order above the ~7,021 DKK commission-efficiency floor, so every second
        # candidate was downsized into a stub the cost guard then rejected. The
        # soft band stays armed at 10% and still cuts deployment by a quarter;
        # only the severity moved, not the trigger or the 25% halt.
        drawdown_soft_buy_multiplier: 0.75
        drawdown_halt_pct: 0.25
      markov:
        enabled: true
        timezone: Europe/Copenhagen
        daily_time: "23:30"
        run_weekdays_only: true
        window_days: 20
        threshold: 0.05
        # Intraday bars. Every tuning here is expressed in calendar units and
        # scaled into bar counts by session_minutes / horizon_minutes, so a
        # 20-day window stays 20 days rather than becoming 20 hours.
        horizon_minutes: 60
        session_minutes: 510
        # A trading session is not the same length everywhere, and every Markov
        # tuning is scaled by it. With one global value, window_days: 20 meant 20
        # trading days on a 9-bar exchange and about 26 on a 7-bar one, silently,
        # for roughly 40% of the universe. Measured against live SIM hourly bars:
        # NASDAQ/NYSE 7 bars a session, Copenhagen/Oslo 8, the rest 9.
        session_minutes_by_exchange:
          xnas: 390
          xnys: 390
          xcse: 480
          xosl: 480
        # 180 window + 540 min-labeled bars needs 722; 900 leaves real headroom
        # for symbols with a shorter intraday history. Saxo caps a request at 1200.
        sample_count: 900
        min_labeled_days: 60
        signal_horizon_days: 5
        # Diagnostic look-aheads, in calendar days. 10 was dropped: by then the
        # forecast is within 0.08 of the stationary distribution, which is already
        # persisted exactly in stationary_json. Information peaks at 2-3 days.
        forecast_steps: [1, 2, 3, 5]
        # Refresh before each decision report rather than only overnight. The
        # scheduler runs Markov after decision reports within one tick, and ticks
        # are 10 minutes apart, so each slot sits well ahead of the report it
        # feeds. us_open is anchored to the report's own zone so the two do not
        # drift apart when US and EU daylight saving disagree.
        intraday_runs:
          - name: europe_open
            local_time: "10:15"
            time_zone: Europe/Copenhagen
          - name: us_open
            local_time: "10:30"
            time_zone: America/New_York
        max_symbols: 0
        instrument_negative_cache_retry_days: 7
        # Read-only analysis aliases for stale portfolio/watchlist symbols. These
        # are used only for Markov/daily-indicator Saxo chart lookup; persisted
        # signals remain keyed by the original symbol.
        symbol_aliases:
          "COST:xnys": "COST:xnas"
          "HON:xnys": "HON:xnas"
          "LIN:xnys": "LIN:xnas"
          "SHELL:xlon": "SHEL:xlon"
      quiver:
        enabled: true
        timezone: Europe/Copenhagen
        # Follow the Saxo US exchange calendar so this completes before the
        # US Open +1h15 Decision Report despite holidays and daylight saving.
        us_open_followup:
          minutes_after_open: 45
          exchange_codes: [XNAS, XNYS]
        run_weekdays_only: true
        lookback_days: 120
        max_symbols: 60
      swing:
        min_holdings: 10
        max_holdings: 25
        # Decision chips are advisory context, not evergreen instructions. Mark
        # report-derived symbols stale after this many days in the dashboard.
        position_decision_stale_after_days: 7
        # Maximum estimated initial loss for a BUY at its automatic ATR stop.
        # Uses a database-verified close, ATR14, and DKK share value; missing
        # evidence fails the BUY closed rather than trusting model-provided data.
        risk_per_trade_pct: 0.01
        # ARKK:xmil is held on the operator's live account and stays in the analysis
        # universe for that reason, but the SIM account has no commission rule for
        # this listing: seven BUYs from 2026-05-05 to 2026-09-02 were all rejected
        # at precheck with "your account does not have any commissions configured".
        # Verified read-only against Saxo's cost endpoint on 2026-09-02 -- the other
        # two ETFs (ARKI:xlon, QOMP:xetr) and Milan stocks (ENEL, ISP) all carry a
        # commission rule, so it is this one listing rather than the asset type or
        # the venue. Listing it here keeps the analysis and drops only the trading:
        # the manager refuses it, and the decision prompt's do_not_propose block
        # stops a candidate slot being spent on it at all.
        never_trade_symbols:
          - arkk:xmil
        daily_indicators:
          enabled: true
          # 0 = full portfolio+watchlist universe (matches the Markov run, ~199
          # symbols). A small cap starves BUY candidates of confluence evidence:
          # the technical gate and Hermes then stand down every rotation into a
          # name outside current holdings.
          max_symbols: 0
          horizon_minutes: 1440
          # Five daily trading years. The support-risk projection reports how much
          # of this target was actually returned, rather than assuming full history.
          sample_count: 1260
          min_confluences: 3
          min_reward_risk: 2.0
          daily_time: "23:45"
          run_weekdays_only: true
          timezone: Europe/Copenhagen
        markov_gate:
          enabled: true
          # Recalibrated 2026-08-31 for hourly bars. At 0.15 the hourly model
          # admitted 132 of 200 symbols where the daily model admitted 111; 0.20
          # admits 113, holding the risk posture the threshold was chosen for.
          min_signed_signal: 0.20
          max_position_pct: 0.05
          max_signal_age_days: 5
        trading_manager:
          enabled: true
          use_ai: true
          due_window_minutes: 20
          # A scheduled report older than this is not eligible to create new
          # execution orders. Keep this explicit so the queue freshness policy
          # cannot silently drift from the Rust default.
          max_report_age_hours: 6
          # Maximum distinct report symbols evaluated per Decision Report in report
          # order. Additional symbols remain visible as skipped audit rows. Set 0
          # for explicit unlimited mode; a negative value fails closed.
          max_symbols: 30
        journal:
          enabled: true
          timezone: Europe/Copenhagen
          daily_time: "22:30"
          weekly_weekday: 6
          weekly_time: "20:00"
          monthly_time: "22:45"
        analysis_pulses:
          timezone: Europe/Copenhagen
          due_window_minutes: 20
          europe_open_followup:
            enabled: true
            # Stable pulse identity uses the local trading date in this zone.
            time_zone: Europe/Copenhagen
            # 105 minutes after the 09:00 open, so the report lands at 10:45 and
            # reads the 10:15 intraday Markov refresh rather than last night's.
            minutes_after_open: 105
            exchange_codes: [XCSE, XSTO, XOSL, XHEL, XLON, XETR, XFRA, XMIL, XAMS]
          us_open_followup:
            enabled: true
            # Anchor US reports to the US session; Copenhagen display follows DST.
            time_zone: America/New_York
            minutes_after_open: 75
            exchange_codes: [XNAS, XNYS]
          europe_mid_session_shadow:
            # Shadow-only: persisted reports cannot enter the manager queue.
            enabled: true
            time_zone: Europe/Copenhagen
            local_time: "14:15"
            exchange_codes: [XCSE, XSTO, XOSL, XHEL, XLON, XETR, XFRA, XMIL, XAMS]
          us_mid_session_shadow:
            # Anchored to the US trading session, not a Copenhagen clock time.
            enabled: true
            time_zone: America/New_York
            local_time: "14:15"
            exchange_codes: [XNAS, XNYS]
      ladder:
        rung_count: 5
        min_rung_value_dkk: 5000
        submit_stop_loss_after_fill: true
        atr_spacing_min: 0.15
        atr_spacing_factor: 0.25
        atr_spacing_max: 0.4
        stop_loss_atr_multiple: 2.0
        take_profit_rung_multiple: 2.0
        max_take_profit_atr_multiple: 8.0
        # Hard cap for total exposure to one symbol after a BUY. The Trading
        # Manager uses persisted position value plus BUYs already approved in the
        # same scheduler cycle; missing or invalid exposure data blocks the BUY.
        max_position_weight: 0.04
        trail_stop_atr_multiple: 2.0
        min_ratchet_atr_fraction: 0.25

    execution:
      mode: live
      adapter: saxo
      auto_execute_simulation: true
      require_approval_live: false
      min_trade_value_dkk: 500
      # BUYs must be large enough that the exchange minimum commission stays
      # under this share of the clip. Raised 0.003 -> 0.004 on 2026-09-03: at 0.003
      # the floor and the 4% position cap sat closer together than one share for
      # expensive names, so ALV:xetr (3,358 DKK/share) needed 2.22-2.94 shares and
      # was refused eight times across seven sessions. Rounding down cost 2.23 DKK
      # more commission than 0.3% allowed; refusing bought nothing. 0 disables.
      max_commission_pct_per_side: 0.004
      max_daily_orders: 50
      # A report can be fresh when queued and stale by the next verified market
      # session. Expire these discretionary rows before any Saxo session/precheck
      # call; protective GoodTillCancel stops are intentionally excluded.
      discretionary_queue_max_age_minutes: 360
      delayed_price_limit_orders:
        enabled: true
        assumed_delay_minutes: 15
        buy_limit_offset_bps: 20
        sell_limit_offset_bps: 20
        replace_threshold_bps: 10
        max_replacements_per_cycle: 25

    risk:
      excluded_symbols: []
      excluded_symbols_csv: ENV:RISK_EXCLUDED_SYMBOLS
      instrument_quarantine:
        enabled: true
        lookback_days: 14
        min_failures: 3
        active_days: 14
      allow_shorting: false

    taxation:
      share_income:
        currency: DKK
        brackets:
          - up_to_dkk: 79000
            rate: 0.27
          - up_to_dkk:
            rate: 0.42

    commissions:
      default_rate: 0.0008
      fx_conversion_rate: 0.0025
      minimums:
        XCSE:
          currency: DKK
          amount: 14.0
        XNAS:
          currency: USD
          amount: 3.0
        XNYS:
          currency: USD
          amount: 3.0
        XLON:
          currency: GBP
          amount: 3.0
        XMIL:
          currency: EUR
          amount: 3.0

    xai:
      provider: openrouter
      api_key: ENV:OPENROUTER_API_KEY
      base_url: https://openrouter.ai/api/v1
      model: openai/gpt-5.5
      reasoning_effort: medium
      max_output_tokens: 8192
      performance_goals:
        currency: DKK
        week_start_weekday: 0
        week_end_weekday: 4
        # Sized to roughly +15% per year on a ~300,000 DKK book (2026-07-25).
        # Revisit these DKK figures when the portfolio value changes materially,
        # otherwise the implied percentage target drifts silently.
        weekly_target_dkk: 880
        monthly_target_dkk: 3800
        stretch_weekly_target_dkk: 1200
      goal: >
        Target approximately +15% portfolio growth per year before tax, which is
        about DKK 880 per Monday-Friday trading week and DKK 3,800 per calendar
        month on the current book. Preserve capital first: a steady, disciplined
        swing horizon beats chasing the target in any single week.
      timeout_seconds: 600
      retry_initial_backoff_seconds: 60
      retry_max_backoff_seconds: 600
      auto_run_interval_minutes: 240

apiVersion: batch/v1
kind: CronJob
metadata:
  labels:
    app: hermes-agent
    cadence: daily
    component: reflection
  name: hermes-daily-reflection
  namespace: saxo
spec:
  concurrencyPolicy: Forbid
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      backoffLimit: 1
      template:
        metadata:
          labels:
            app: hermes-agent
            cadence: daily
            component: reflection
        spec:
          automountServiceAccountToken: false
          containers:
          - command:
            - /bin/sh
            - -ec
            - |
              if [ -z "${API_SERVER_KEY:-}" ]; then
                echo "API_SERVER_KEY is required; set HERMES_API_SERVER_KEY in .env and redeploy." >&2
                exit 1
              fi
              if [ -z "${HERMES_DAYTRADER_API_KEY:-}" ]; then
                echo "HERMES_DAYTRADER_API_KEY is required for the daytrader adapter." >&2
                exit 1
              fi
              DAYTRADER_API_BASE_URL="${DAYTRADER_API_BASE_URL:-http://daytrader-api.saxo:8000}"
              RUN_DATE="$(date -u +%Y-%m-%d)"
              RUN_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
              SOURCE_SESSION_ID="daily-eod-reflection-${RUN_DATE}"
              WAIT_SECONDS="${HERMES_REFLECTION_WAIT_SECONDS:-90}"
              cat > /tmp/hermes-run.json <<EOF
              {
                "session_id": "saxo-daytrader-daily-eod-reflection",
                "input": "Run the saxo daytrader daily end-of-day learning loop for ${RUN_DATE}. STEP 1 - read the evidence in ONE call. Call get_context with limit 8, detail compact, and sections: decisions, end_of_day, execution, markov_method, performance, hermes, goal_contract, scheduler, strategy_journal. That single payload carries today's decision-report pulses, the end-of-day report, execution outcomes and failures, Markov regime signals, scheduler status, performance against the goal contract, the read-only gate_replay evidence, and the experiment inventory. The single-purpose readers get_decision_reports, get_end_of_day_reports, get_markov_signals and get_quiver_signals are deliberately absent from this gateway: they returned the same rows a second time, and every tool result stays in context for the rest of the run. If a block you need is genuinely missing, call get_context again with different sections rather than working around it. STEP 2 - write exactly one concise reflection with create_reflection, setting source_session_id to ${SOURCE_SESSION_ID}, period_start to ${RUN_DATE}, and period_end to ${RUN_DATE}. STEP 3 - at most one experiment. If the day holds a concrete learning that can be tested safely, call create_experiment_proposal once with the same source_session_id, changing exactly one variable, preferring execution.min_trade_value_dkk, strategy.capital.min_cash_buffer_pct, strategy.swing.daily_indicators.min_confluences, or strategy.swing.markov_gate.min_signed_signal. Never duplicate an existing pending or active proposal for the same changed_variable_path. If the call returns advisory related-family context, defer that relationship to operator review: do not merge, reject, or activate the other variable. If the evidence is insufficient, record proposed_actions in the reflection instead and say what is missing. READING RULES. The experiment inventory intentionally omits pending-review values; do not infer or request them. gate_replay is historical comparison only, and a target-gate clear is not an approval. reachability describes the deterministic gate alone: unreachable_in_retained_evidence means no candidate met that gate precondition during the window. Act on effect_path in supported_variable_coverage instead. gate_only and gate_and_advisory mean a change moves a deterministic gate. advisory_only means the gate bound nothing but the number is published to you in the decision preflight, so a change would move advice rather than a gate - propose it only if you say which of the two you intend to move. no_observed_effect is the only value that means a proposal cannot produce a measurable effect at any value. The sections.omitted list names blocks that were not requested: their absence is not evidence that the underlying data is empty. Detail compact removes repetition, not facts: where a field held the same value on every element of a list it was lifted into a sibling key ending in _shared, so read each _shared field as belonging to every element of the list beside it, and read the compaction block for exactly what was applied. Never request or expose Saxo tokens, AccountKey, ClientKey, OAuth payloads, database credentials, or broker mutation endpoints.",
                "instructions": "You are Hermes Agent acting as a daily EOD learning agent for the saxo-rust day/swing trading system. You may observe, write one reflection, and create at most one pending-review experiment proposal. You must not place, approve, replace, or cancel orders. You must not access /api/saxo/* or any Saxo session/token source. Use the configured daytrader MCP adapter or the protected /api/hermes/* adapter only.",
                "metadata": {
                  "source": "kubernetes-cronjob",
                  "job": "hermes-daily-reflection",
                  "cadence": "daily"
                }
              }
              EOF
              curl -fsS \
                -H "Authorization: Bearer ${API_SERVER_KEY}" \
                -H "Content-Type: application/json" \
                --data @/tmp/hermes-run.json \
                http://hermes-reflections.saxo:8642/v1/runs
              echo
              sleep "${WAIT_SECONDS}"
              if curl -fsS \
                -H "Authorization: Bearer ${HERMES_DAYTRADER_API_KEY}" \
                "${DAYTRADER_API_BASE_URL}/api/hermes/reflections?limit=20" \
                | grep -F "\"source_session_id\":\"${SOURCE_SESSION_ID}\"" >/dev/null; then
                echo "Hermes daily reflection recorded with source_session_id=${SOURCE_SESSION_ID}."
                exit 0
              fi
              echo "Hermes daily run did not record source_session_id=${SOURCE_SESSION_ID}; writing watchdog reflection." >&2
              cat > /tmp/hermes-watchdog-reflection.json <<EOF
              {
                "period_start": "${RUN_DATE}",
                "period_end": "${RUN_DATE}",
                "goal_version": 2,
                "summary": "Daily reflection watchdog: Hermes run was submitted at ${RUN_STARTED_AT}, but no reflection with source_session_id ${SOURCE_SESSION_ID} was recorded within ${WAIT_SECONDS}s. Review Hermes gateway/model/MCP logs before trusting the daily reflection loop.",
                "findings": [{"severity": "warning", "topic": "hermes_daily_reflection", "detail": "Scheduled Hermes run did not persist a daily reflection within the watchdog window."}],
                "proposed_actions": [],
                "source_session_id": "${SOURCE_SESSION_ID}",
                "raw_payload": {"source": "kubernetes-cronjob-watchdog", "job": "hermes-daily-reflection", "submitted_at": "${RUN_STARTED_AT}"}
              }
              EOF
              curl -fsS \
                -H "Authorization: Bearer ${HERMES_DAYTRADER_API_KEY}" \
                -H "Content-Type: application/json" \
                --data @/tmp/hermes-watchdog-reflection.json \
                "${DAYTRADER_API_BASE_URL}/api/hermes/reflections"
            envFrom:
            - secretRef:
                name: hermes-env
                optional: true
            image: curlimages/curl:8.17.0
            imagePullPolicy: IfNotPresent
            name: submit-reflection
            resources:
              limits:
                cpu: 100m
                memory: 128Mi
              requests:
                cpu: 10m
                memory: 32Mi
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                - ALL
              readOnlyRootFilesystem: true
              runAsGroup: 65532
              runAsNonRoot: true
              runAsUser: 65532
              seccompProfile:
                type: RuntimeDefault
            volumeMounts:
            - mountPath: /tmp
              name: tmp
          restartPolicy: Never
          securityContext:
            fsGroup: 65532
            runAsGroup: 65532
            runAsNonRoot: true
            runAsUser: 65532
            seccompProfile:
              type: RuntimeDefault
          volumes:
          - emptyDir:
              medium: Memory
            name: tmp
  schedule: 45 23 * * 1-5
  successfulJobsHistoryLimit: 5
  suspend: false
  timeZone: Europe/Copenhagen

          if [ -n "${HERMES_DAYTRADER_API_KEY:-}" ]; then
            /opt/hermes/.venv/bin/python - <<'PY' || true
          import os
          from pathlib import Path

          import yaml

          path = Path("/opt/data/config.yaml")
          data = {}
          if path.exists():
              data = yaml.safe_load(path.read_text()) or {}
          servers = data.setdefault("mcp_servers", {})
          servers["daytrader"] = {
              "url": os.environ.get("DAYTRADER_MCP_URL", "http://daytrader-mcp.saxo:8610/mcp"),

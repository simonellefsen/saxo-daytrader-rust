FROM rust:1.95-bookworm AS builder

WORKDIR /app
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates musl-tools \
    && rm -rf /var/lib/apt/lists/*
COPY . .
RUN case "${TARGETARCH:-amd64}" in \
      amd64) echo x86_64-unknown-linux-musl > /tmp/rust-target ;; \
      arm64) echo aarch64-unknown-linux-musl > /tmp/rust-target ;; \
      *) echo "Unsupported TARGETARCH=${TARGETARCH:-unset}" >&2; exit 1 ;; \
    esac \
    && rustup target add "$(cat /tmp/rust-target)" \
    && cargo build --release --target "$(cat /tmp/rust-target)" --bin saxo-rust \
    && cp "target/$(cat /tmp/rust-target)/release/saxo-rust" /tmp/saxo-rust \
    && mkdir -p /tmp/runtime/daytrader

FROM scratch

WORKDIR /app
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /tmp/saxo-rust /app/saxo-rust
COPY --from=builder --chown=65532:65532 /tmp/runtime /tmp
COPY config.yaml /app/config/config.yaml

ENV DAYTRADER_CONFIG=/app/config/config.yaml \
    BIND_ADDR=0.0.0.0:8000

EXPOSE 8000
USER 65532:65532

CMD ["/app/saxo-rust"]

[Unit]
Description=Saxo Daytrader Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_DIR}}
Environment=PYTHONUNBUFFERED=1
ExecStart={{PYTHON_BIN}} {{PROJECT_DIR}}/scripts/run_scheduler.py --config {{PROJECT_DIR}}/config.yaml
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
